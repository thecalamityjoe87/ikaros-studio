  <name>Ikaros Studio</name>
  <summary>Make music with an easy, friendly studio</summary>
  <developer id="io.github.thecalamityjoe87">
    <name>ikarosdev</name>
  </developer>

  <description>
    <p>
      Ikaros Studio is a beginner-friendly music studio. Pick a sound, play it on the
      on-screen keyboard or a MIDI keyboard, and arrange regions on a timeline.
      It stays simple by default, with advanced controls tucked away until you ask for them.
    </p>
    <ul>
      <li>Instrument tracks with a built-in synthesizer</li>
      <li>MIDI regions, loop playback and a metronome</li>
      <li>Sound controls, effects and a simple mixer</li>
      <li>Works the same on Linux, Windows and macOS</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.thecalamityjoe87.IkarosStudio.desktop</launchable>
  <provides>
    <mediatype>application/x-ikaros-session</mediatype>
  </provides>
